# Copy to .env.local and fill in your own values.
#
# Every value here is intentionally blank. This repo ships with no credentials,
# no project URLs, and no connection to any hosted database — supply your own
# Supabase project and API keys to run it. See docs/SECURITY.md.

# --- Required ---
# Supabase project (create one at supabase.com, then run the migrations in
# supabase/migrations). The service-role key is server-only; never expose it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI providers.
ANTHROPIC_API_KEY=
GOOGLE_GEMINI_API_KEY=
HEYGEN_API_KEY=

# Background jobs (inngest.com).
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Optional ---
# Secondary text model.
OPENAI_API_KEY=

# Email digests — set one.
RESEND_API_KEY=
SENDGRID_API_KEY=

# Publishing via n8n: one webhook per platform, one shared HMAC secret used to
# sign outbound calls and verify the inbound status callback.
N8N_WEBHOOK_URL_INSTAGRAM=
N8N_WEBHOOK_URL_FACEBOOK=
N8N_WEBHOOK_URL_LINKEDIN=
N8N_WEBHOOK_URL_YOUTUBE=
N8N_WEBHOOK_SECRET=

# Direct publishing via each platform's OAuth app.
META_APP_ID=
META_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Base URL used to build OAuth redirect URIs (defaults to http://localhost:3000).
APP_URL=

# 32-byte key (hex or base64) encrypting stored OAuth tokens at rest.
SOCIAL_TOKEN_ENC_KEY=
